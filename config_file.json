{
    "target": "compro",
    "method": "bayes",
    "task": "classification",
    "hyperparameters_knn":{
        "n_neighbors": [1, 3, 5],
        "p": [1, 2],
        "weights": ["uniform", "distance"]
    },
    "hyperparameters_tree":{
        "max_depth": [3, 5, 10],
        "criterio": ["gini", "entropy"]
    },
    "hyperparameters_bayes": {
        "var_smoothing": [1e-9, 1e-8, 1e-7, 1e-5]
    },
    "preprocessing":{
        "categorical_features":["producto","metodo_pago"],
        "text_features": ["opinion_cliente"],
        "boolean_features": ["descuento"],
        "missing_values": "impute",
        "impute_strategy": "mean",
        "scaling": "z-score",
        "text_process": "tf-idf",
        "sampling": "oversampling"
    }
}