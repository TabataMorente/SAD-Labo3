{
    "target": "nombre_columna",     //columna a predecir
    "method": "knn",                //knn,tree,bayes,forest
    "task": "classification",       //clasificación o regresión
    "hyperparameters_knn":{         //hiperparametros de knn: k = {1,2,3,4,5,...}, p = 0/1, w = 0/1
        "n_neighbors": [1, 3, 5],   // IMPORTANTE: Aquí se pone un limite maximo y minimo
        "p": [1, 2],
        "weights": ["uniform", "distance"]
    },
    "hyperparameters_tree":{
        "max_depth": [3, 5, 10],
        "criterio": ["gini", "entropy"]
    },
    "hyperparameters_bayes": {
        // Suavizado de varianza: Ayuda al modelo GaussianNB a no ser tan rígido
        // con los datos que se alejan mucho de la media (evita divisiones por cero).
        "var_smoothing": [1e-9, 1e-8, 1e-7, 1e-5],

        // Tipo de algoritmo: 'multinomial' es ideal cuando discretizamos
        // o usamos frecuencias de palabras (como en nuestro caso).
        "bayes_type": "multinomial",

        // Parámetro Alpha: Es el 'Suavizado de Laplace'.
        // Suma un pequeño valor a los conteos para que ninguna probabilidad sea 0%.
        "alpha": [0.1, 0.5, 1.0, 2.0]
    },
    "preprocessing":{
        "categorical_features":[], //columnas categoriales: pasar a numeros
        "text_features": [],       //columnas de texto, por ejemplo un mensaje.
        "boolean_features": [],    //columnas booleanas en formato texto
        "missing_values": "impute",//impute o drop (eliminar)
        "impute_strategy": "mean", //mean, median, mode
        "discretize_features": ["edad"],//columnas a discretizar
        "discretize_bins": 3,           //cuantos intervalos o categorias
        "scaling": "max-min",      //max, max-min, z-score
        "text_process": "tf-idf",  //tf-idf,one-hot,bow
        "sampling": "undersampling"//undersampling, oversampling, none
    }
}